# Edge-cache the HTML shell per-route (s-maxage=300). NOT on /* — CF Pages
# concatenates Cache-Control across matching rules, which would pollute
# /assets/* (breaking immutable) and /version.json. Per-route avoids overlap.
# /version.json + the SPA fallback keep the CF default (max-age=0) → instant
# deploy-provenance check. Keep in sync with seo-prerender ROUTES.
/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/homes-for-sale-temecula/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/russian-speaking-realtor-temecula/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/sell-my-house/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/about-george/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/contact/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

# /blog was unrouted 2026-07-24 (falls through to the NotFound catch-all) but
# was never added above, so it silently inherited CF's 7-day default HTML
# cache and kept serving stale pre-unpublish content at the edge — required
# a manual purge to clear. no-store here (not the 300s pattern above) so any
# currently-unlisted path — /blog now, or whatever's next — can never again
# go stale for days unnoticed. Explicit no-slash + slash + wildcard so this
# can't depend on exact CF Pages glob semantics for the bare route.
/blog
  Cache-Control: no-store
/blog/
  Cache-Control: no-store
/blog/*
  Cache-Control: no-store

/assets/*
  Cache-Control: public, max-age=31536000, immutable

