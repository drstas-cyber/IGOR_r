  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://connect.facebook.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://api.emailjs.com https://www.google-analytics.com https://analytics.google.com https://*.google-analytics.com https://googleads.g.doubleclick.net https://stats.g.doubleclick.net https://www.google.com https://www.googleadservices.com https://static.cloudflareinsights.com https://connect.facebook.net; frame-src 'self' https://www.googletagmanager.com https://td.doubleclick.net https://*.doubleclick.net https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /csp-report

# Edge-cache the HTML shell per-route (s-maxage=300). NOT on /* — CF Pages
# concatenates Cache-Control across matching rules, which would pollute
# /assets/* (breaking immutable) and /version.json. Per-route avoids overlap.
# /version.json + the SPA fallback keep the CF default (max-age=0) → instant
# deploy-provenance check. Keep in sync with seo-prerender ROUTES.
/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/homes-for-sale-temecula/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/russian-speaking-realtor-temecula/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/sell-my-house/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/about-george/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/contact/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

# /blog relaunched 2026-07-27 (real routes, real content, was unrouted
# placeholder before that -- see the git history for the no-store block
# this replaces, kept the /blog was unrouted... incident stale for
# reference). Same per-route 300s edge-cache pattern as the routes above,
# now that /blog/ and its articles are real, actively-served pages rather
# than an unrouted path silently inheriting CF's 7-day default.
#
# NOT a /blog/* wildcard, deliberately: CF Pages _headers rules CONCATENATE
# across overlapping patterns rather than "most specific wins" (verified
# empirically this session, see the dead-slug block below) -- a wildcard
# no-store rule here would concatenate onto these specific routes' 300s
# rule rather than being overridden by it, silently defeating caching for
# every article again. Both slash and bare forms listed per route, same
# reason as the dead-slug block below (verified: Cloudflare does not 301
# the bare form to the slash form on this site).
#
# OPTION D (Batch F): article cache coverage comes from the two
# PLACEHOLDER rules below, not from one concrete pair per article.
# `:slug` is a Cloudflare Pages placeholder matching exactly ONE path
# segment -- it is NOT a wildcard/splat. /blog/* is still PROHIBITED for
# Cache-Control here, for the concatenation reason above.
#
# Publication no longer appends anything to this file: the rule count is
# fixed at 12 regardless of how many articles exist, and a brand-new
# article is covered the moment it is served. A concrete /blog/<slug>
# rule must NEVER be re-introduced alongside these placeholders -- both
# would match the same request and CF would CONCATENATE the two
# identical Cache-Control values. validateBlogArticleCacheCoverage()
# in tools/blog-generator/headersCacheEntry.mjs enforces all of this and
# fails closed; publishStatusReport/publishOnMerge/retroAudit all read it.
#
# NOT YET PREVIEW-VERIFIED: whether /blog/:slug also matches /blog and
# /blog/ (which already have their own literal rules above), and whether
# the bare and trailing-slash placeholders can both match one request,
# must be confirmed with curl against a Cloudflare Pages preview before
# this is accepted in production.
/blog/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/blog
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/blog/:slug/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate
/blog/:slug
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Dead BabyLoveGrowth blog articles' X-Robots-Tag:noindex block (50 rules,
# 25 slugs x 2 forms) REMOVED 2026-08-13 -- redundant now that these paths
# return a real HTTP 404 (see NotFound.jsx / public/404.html and the
# public/_redirects SPA-catch-all removal, same commit). A 404 already
# keeps a page out of the index; noindex-ing a path that no longer serves
# 200 content at all was defensive layering that stopped earning its
# 50-rule cost the moment the underlying soft-404 became a real one.
# Verified on Cloudflare Pages preview before this merged: all 25 dead
# slugs (both URL forms) return a genuine 404 with noindex via the shared
# 404.html, not a 200. If a future regression ever makes a dead slug 200
# again, that's a real bug to fix at the routing layer, not something to
# paper back over with this block.
