node_modules
dist
.DS_Store
*.local
.env
.env.*
!.env.example
001_web/.netlify/

# Deploy / tooling state — never commit
.netlify/
.wrangler/
.claude/

# Build-time generated — regenerated by tools/generate-llms.js on every build
public/llms.txt

# Build-time generated — regenerated by tools/fetch-blog-data.js's compliance
# filter on every build that has BABYLOVE_API_KEY set
tools/blog-compliance/last-report.json

# Ephemeral run report from tools/blog-generator/generate.mjs — read by the
# GitHub Actions workflow to build the PR body, not meant to persist in git.
tools/blog-generator/.last-run-report.json

# Raw content snapshot from a real BABYLOVE_API_KEY fetch — contains full
# article bodies (including the exclusivity/DRE claims found during the
# 2026-07-26 audit) and must never reach git history. Enables offline mode
# (BLOG_COMPLIANCE_FIXTURE=true) so subsequent runs don't need the key.
tools/blog-compliance/.articles-cache.json
